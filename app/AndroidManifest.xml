<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="no.safestart.kiosk"
    android:versionCode="1"
    android:versionName="0.1-test">

    <uses-sdk android:minSdkVersion="23" android:targetSdkVersion="34" />

    <uses-permission android:name="android.permission.REORDER_TASKS" />
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Granted automatically to a Device Owner; only used on API 34+. -->
    <uses-permission android:name="android.permission.MANAGE_DEVICE_POLICY_STATUS_BAR" />

    <!-- The kiosk is installed by a parent, not from a phone-only store, and a
         Wi-Fi tablet without a SIM must still be able to run it. -->
    <uses-feature android:name="android.hardware.telephony" android:required="false" />

    <!-- Android 11 (API 30) hides other apps from PackageManager unless they are
         declared here. Without this block the lock task allowlist collapses to
         our own package and every external tile silently stops working. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.DIAL" />
            <data android:scheme="tel" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.APP_MESSAGING" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="sms" />
        </intent>
        <intent>
            <action android:name="android.media.action.STILL_IMAGE_CAMERA" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="geo" />
        </intent>
        <package android:name="no.skyss.billett" />
        <package android:name="no.skyss.reise" />
        <package android:name="no.skyss" />
        <package android:name="no.skyss.tickets" />
    </queries>

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/Safestart"
        android:allowBackup="false">

        <activity
            android:name=".HomeActivity"
            android:exported="true"
            android:launchMode="singleInstance"
            android:stateNotNeeded="true"
            android:excludeFromRecents="true"
            android:clearTaskOnLaunch="true"
            android:resizeableActivity="false"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ParentActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:resizeableActivity="false"
            android:label="@string/parent_title" />

        <activity
            android:name=".ChessActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:resizeableActivity="false"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:label="@string/chess_title" />

        <receiver
            android:name=".AdminReceiver"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <!-- Re-applies the Device Owner policy after a reboot. It must never
             start an activity: background activity starts are restricted from
             API 29 and the system already brings HOME back by itself. -->
        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
